# Archived runs of the state files above.
archive/

# Third-party wallet history pulled from the public data API for analysis.
# Public on-chain data, but republishing someone's full trade record is a
# deliberate act, not a side effect of committing the bot.
wallet_activity.json
wallet2_activity.json
wallet_positions.json

# Editor/tooling backups.
*.bak
*.bak[0-9]

# Live diagnostics - may name venue fields; keep local.
live_diagnostics.log

# Runtime decision journals and pulled wallet history: your own trade
# record, and not something a public repo should carry.
*_decisions.csv
live_activity.json

# Working data dumps: real positions, PnL and account activity.
# pos.json carries avgPrice/cashPnl/currentValue/entryFeesUsdc for live
# positions and act.json ~3k activity records, so a plain `git add -A`
# would publish the account. Ignored by name rather than left merely
# unadded.
pos.json
act.json
mkt.json
all_mkts.json
_ledgers.json
_sig.json
.test-tmp/

# Active paper/live state (the multi_* profile) and the signal journal.
multi_*.json
multi_*.csv
multi_*.jsonl
# Fill-timing diagnostics: order ids and timing from paper and live runs.
*_fill_delay.jsonl
live_fill_timing.jsonl
live_ledger.json
