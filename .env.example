# ---------------------------------------------------------------------------
# Example configuration - PAPER mode.
#
#   cp .env.example .env
#   chmod 600 .env                      # required on POSIX, see SECURITY.md
#
# Every value below is the SHIPPED DEFAULT. Copying this file therefore
# changes nothing: it is a readable inventory of what the bot already does,
# so you can see a setting before you decide to move it. Delete a line to
# fall back to that same default.
#
# This file contains NO credentials and is safe to commit. Live trading needs
# a wallet key, which must never be written here - see SECURITY.md.
# ---------------------------------------------------------------------------

# ---- mode -----------------------------------------------------------------
# Paper is the default and needs no variable. Live mode is opt-in at the
# command line (`python run_feeds.py --live`), never through this file.
# Starting cash for the FIRST paper launch only; afterwards the persisted
# paper_account.json wins so a restart cannot reset PnL.
PAPER_START_BALANCE=1000

# ---- phase 1: price-band entry (ON by default) ----------------------------
# The shipped entry path. Bands are "start:end:low:high[:interval]" in
# SECONDS REMAINING, listed from the open toward expiry. The band decides
# whether the selected contract is affordable; fresh Binance SIG PRICE is the
# sole authority for the order side.
PHASE1_ENABLED=1
PHASE1_BANDS=300:240:0.35:0.45,240:180:0.30:0.40,180:120:0.40:0.50,120:60:0.55:0.75:8
PHASE1_INTERVAL_SECONDS=12

# ---- phase 2: signal entry (OFF by default) -------------------------------
# The experimental path. Enable it explicitly to run it. See STRATEGIES.md
# for the profiles that switch phase 1 off and phase 2 on together.
PHASE2_ENABLED=0
# Which signal picks the order side: price | minority | final.
# "price" keeps SIG BOOK and SIG CHAINLINK as diagnostics that never override
# fresh Binance direction.
SIGNAL_DECISION_RULE=price
# Optional phase-2 filters, all off by default.
PHASE2_PARTIAL_SIGNALS=0
PHASE2_MULTI_SIGNAL=0
REQUIRE_SIGNAL_UNANIMITY=0
TAPER_HEDGE_ENABLED=0
PAIR_LOCK_ENABLED=0

# ---- sizing and price bounds ----------------------------------------------
# Stake per entry, before the venue's 5-share minimum sizes it up.
BET_SIZE=2.50
MAX_BUY_PRICE=0.90
MIN_BUY_PRICE=0.20

# ---- timing ---------------------------------------------------------------
# Phase 2 trades the last TRADE_LAST_SECONDS of a round, every
# TRADE_INTERVAL_SECONDS, and stops MIN_SECONDS_TO_EXPIRY before the close.
# Every phase-2 skip path also waits one full TRADE_INTERVAL_SECONDS.
TRADE_LAST_SECONDS=120
TRADE_INTERVAL_SECONDS=6
MIN_SECONDS_TO_EXPIRY=60

# ---- risk caps ------------------------------------------------------------
# Worst-case cash for ONE round. Left unset it is DERIVED from the phases
# that are actually enabled, which is what the defaults in this file do:
# phase 1 alone works out to $72.225. Setting it explicitly pins it, so a
# later change to the bands or the cadence no longer moves it with them -
# leave it commented out unless you want that.
# MAX_ROUND_EXPOSURE=72.225
# Ceiling on cash committed to rounds the venue has not resolved yet, across
# ALL open rounds. 0 disables it, which is the shipped default.
MAX_UNSETTLED_EXPOSURE=0

# ---- reversal / complement legs (off by default) --------------------------
# Buying the second outcome of a market the bot already holds. LIVE keeps the
# block unconditionally regardless of these.
PAPER_ALLOW_SIGNAL_FLIPS=0
LIVE_ALLOW_SIGNAL_FLIPS=0

# ---- feeds ----------------------------------------------------------------
# ws_shadow keeps the audited REST book as the strategy input while the
# maintained WebSocket book is compared against it. See FEEDS.md.
BOOK_SOURCE=ws_shadow
BTC_FEED=ws
USER_WS=on
RECONCILE=auto
PRICE_STALE_POLICY=none
# Modeled own-latency before a paper fill; the venue's published matching
# delay is added on top and a missing one fails the order closed.
PAPER_LATENCY_MS=150

# ---- settlement -----------------------------------------------------------
# Default settlement requires the public CLOB winner surface and Gamma's
# explicit oracle resolution to agree independently. Both switches below
# RELAX that invariant and are off by default - read DEEP_AUDIT.md
# "SETTLE_ONCHAIN audit" before enabling either.
SETTLE_ONCHAIN=0
SETTLE_TRUST_GAMMA=0

# ---- paper state file paths (optional) ------------------------------------
# Relative paths resolve beside main_bot.py. Move the account and ledger
# together or startup fails closed. Unset means the defaults below.
# PAPER_LEDGER_PATH=paper_ledger.json
# PAPER_ACCOUNT_PATH=paper_account.json
# PAPER_AUDIT_PATH=paper_orders.jsonl
# PAPER_TRADE_LOG_PATH=paper_trade_log.csv
# BOT_TRADE_LOG_PATH=trade_log.csv
